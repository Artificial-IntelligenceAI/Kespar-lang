// §1: comments, underscores, bin literals, text escapes, the \n piece, quoted names
MAIN {
    var 'million' := [1_000_000];   // underscores between digits
    var 'my name' := ["quote \" and backslash \\"];
    var.bin64 'e' = [2.0e10];
    var.bin32 'small' = [1.5e-3];
    std::print.stdout['million' \n 'my name' \n 'e' " " 'small' \n];
    std::print.stdout["no newline"];
    std::print.stdout[\n "true is " true \n];
}
