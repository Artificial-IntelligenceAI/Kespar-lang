// --trace-checks: one line per site in source order, then free integer names
func.int32 sq [var.int32 'x'] {
    return ['x' x 'x'];
}
MAIN {
    var.int32 'n' = [std::read.stdin[0, 100]];
    var 'free' := [1];
    var 'never' := [0];
    var 'xs' := [1, 2];
    loop.for 'i' in [std::range[1, 'n']] {
        'free' = ['free' x 3];
    }
    var 'total' := [sq['n'] / 'n'];
    std::print.stdout['total' " " 'free' " " 'xs'[std::len['xs'] - 1] \n];
    if [false] { 'never' = ['never' + 1]; }
    var.int8 'small' = [std::to.int8['n']];
    var 'q' := [sq['n'] xx 'n'];
}
